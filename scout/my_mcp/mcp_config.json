{
  "mcpServers": {
    "dataflow": {
      "type": "stdio",
      "command": "python",
      "args": [
        "/app/scout/my_mcp/local_servers/dataflow.py"
      ]
    },

    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${MCP_FILESYSTEM_DIR}"
      ]
    },

    "bright-data": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@brightdata/mcp"
      ],
      "env": {
        "API_TOKEN": "${BRIGHTDATA_API_TOKEN}"
      }
    },

    "git": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "tool",
        "run",
        "mcp-server-git"
      ]
    },

    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${MCP_GITHUB_PAT}"
      }
    },

    "deployment": {
      "type": "stdio",
      "command": "python",
      "args": [
        "/app/scout/my_mcp/local_servers/deployment/server.py"
      ]
    },

    "ec2-deployment": {
      "type": "stdio",
      "command": "python",
      "args": [
        "/app/scout/my_mcp/local_servers/ec2_deployment/server.py"
      ],
      "env": {
        "EC2_HOST": "${EC2_HOST}",
        "EC2_USER": "${EC2_USER}",
        "EC2_KEY_PATH": "${EC2_KEY_PATH}"
      }
    }
  }
}